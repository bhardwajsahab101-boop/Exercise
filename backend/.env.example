# NestJS Server Configuration
PORT=3000
NODE_ENV=development

# Supabase Configuration
# IMPORTANT: Use your Supabase URL and keys.
# The backend uses the SUPABASE_SERVICE_ROLE_KEY strictly server-side for admin DB operations if needed,
# or SUPABASE_ANON_KEY / JWT verification to query database scoped to authenticated user context.
# NEVER expose the service-role key to the frontend!
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Allowed CORS origins
FRONTEND_URL=http://localhost:5173

# Single Workout Owner Configuration
# Set the user ID and/or email of your existing Supabase owner user.
# Write and share-management operations will be strictly restricted to this account.
OWNER_USER_ID=470af75f-61e0-40c9-b760-aab5730b9f94
OWNER_EMAIL=
