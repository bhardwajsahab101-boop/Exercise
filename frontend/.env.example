# Stride Frontend Environment Configuration

# NestJS API Base URL (Frontend communicates strictly through NestJS API)
VITE_API_BASE_URL=http://localhost:3000/api

# Supabase Public Keys (For optional direct Auth / Magic Link sign-in on frontend)
# NOTE: NEVER put SUPABASE_SERVICE_ROLE_KEY here! Only use the ANON public key.
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
